{
  "type": "minecraft-java-arm64",
  "display": "Minecraft Java (ARM64 native: Vanilla / Fabric / Paper)",
  "icon": "minecraft-java",
  "data": {
    "eula": {
      "type": "boolean",
      "value": false,
      "display": "EULA Agreement (true/false)",
      "desc": "Do you (or the server owner) agree to the <a href='https://account.mojang.com/documents/minecraft_eula'>Minecraft EULA?</a>",
      "required": true,
      "userEdit": true
    },
    "javaversion": {
      "type": "string",
      "value": "25",
      "display": "Java Version",
      "desc": "Select an ARM64 Java version supported by your Minecraft release.",
      "required": true,
      "userEdit": true
    },
    "jvmArgs": {
      "type": "string",
      "value": "",
      "display": "JVM Arguments",
      "desc": "Extra JVM arguments to pass",
      "required": false,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 2048,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate to the Java Heap",
      "required": true,
      "userEdit": true
    },
    "modlauncher": {
      "type": "option",
      "value": "",
      "display": "Mod/Plugin Launcher",
      "desc": "Select Vanilla, Fabric or Paper. Forge/NeoForge are not included in this template.",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "",
          "display": "Vanilla"
        },
        {
          "value": "fabric",
          "display": "Fabric"
        },
        {
          "value": "paper",
          "display": "Paper"
        }
      ]
    },
    "motd": {
      "type": "string",
      "value": "Minecraft ARM64 server",
      "display": "MOTD message of the day",
      "desc": "This is the message that is displayed in the server list of the client, below the name. The MOTD does support <a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>color and formatting codes</a>.",
      "required": true,
      "userEdit": true
    },
    "paperbuild": {
      "type": "string",
      "value": "latest",
      "display": "build",
      "desc": "Build of Paper to install (<a href='https://papermc.io/downloads'>Paper version build</a>). Must be specified as a build number, e.g. `484`, or `latest`",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "What port to bind the server to",
      "required": true,
      "userEdit": true
    },
    "version": {
      "type": "string",
      "value": "latest",
      "display": "Version",
      "desc": "Version of Minecraft you wish to install. It is best to put a version in, as latest may not work with all server software.",
      "required": true,
      "userEdit": true
    }
  },
  "groups": [
    {
      "display": "General",
      "variables": [
        "eula",
        "memory",
        "port",
        "motd",
        "version",
        "javaversion",
        "modlauncher",
        "jvmArgs"
      ],
      "order": 1
    },
    {
      "if": "modlauncher == 'paper'",
      "display": "Paper",
      "variables": [
        "paperbuild"
      ],
      "order": 2
    }
  ],
  "install": [
    {
      "type": "javadl",
      "version": "${javaversion}"
    },
    {
      "type": "mojangdl",
      "if": "modlauncher == ''",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "type": "fabricdl",
      "if": "modlauncher == 'fabric'"
    },
    {
      "type": "command",
      "if": "modlauncher == 'fabric'",
      "commands": [
        "java${javaversion} -jar fabric-installer.jar server -mcversion ${version} -downloadMinecraft -noprofile -loader latest"
      ]
    },
    {
      "type": "mojangdl",
      "if": "modlauncher == 'fabric'",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "type": "paperdl",
      "if": "modlauncher == 'paper'",
      "build": "${paperbuild}",
      "minecraftVersion": "${version}",
      "target": "server.jar"
    },
    {
      "type": "writefile",
      "if": "!file_exists('server.properties')",
      "target": "server.properties",
      "text": "server-port=${port}\nmotd=${motd}\n"
    },
    {
      "type": "writefile",
      "target": "eula.txt",
      "text": "eula=${eula}\n"
    }
  ],
  "run": {
    "command": [
      {
        "if": "modlauncher == 'fabric' && file_exists('fabric-server-launch.jar')",
        "command": "java${javaversion} -Xmx${memory}M -Dterminal.jline=false ${jvmArgs} -jar fabric-server-launch.jar nogui"
      },
      {
        "if": "modlauncher != 'fabric' && file_exists('server.jar')",
        "command": "java${javaversion} -Xmx${memory}M -Dterminal.jline=false ${jvmArgs} -jar server.jar nogui"
      }
    ],
    "stop": "stop",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "arm64"
  },
  "stats": {
    "type": "jcmd"
  },
  "query": {
    "type": "minecraft"
  }
}
